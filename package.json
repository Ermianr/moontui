{
  "name": "moontui",
  "private": true,
  "version": "0.1.0",
  "description": "MoonTUI - A TUI library with Rust core and TypeScript bindings",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/core build -- --all",
    "build:native": "bun run --cwd packages/core build -- --native",
    "build:lib": "bun run --cwd packages/core build -- --lib",
    "build:codegen": "bun scripts/generate-ffi.ts",
    "test": "cargo test && bun test --cwd packages/core",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- --deny warnings",
    "check:all": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- --deny warnings && ultracite check",
    "prepare-release": "bun scripts/prepare-release.ts",
    "pre-publish": "bun scripts/pre-publish.ts",
    "publish": "bun run --cwd packages/core scripts/publish.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "bun run --cwd packages/core typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@moontui/config": "workspace:*",
    "typescript": "^6.0.3",
    "ultracite": "7.8.0",
    "@types/bun": "1.3.14"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
