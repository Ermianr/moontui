{
  "name": "@moontui/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Core TypeScript bindings for MoonTUI",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:codegen": "bun ../../scripts/generate-ffi.ts",
    "typecheck": "bunx tsc --noEmit",
    "publish": "bun publish"
  },
  "files": [
    "dist/",
    "native/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@moontui/config": "workspace:*",
    "typescript": "^6.0.3",
    "@types/bun": "1.3.14"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
